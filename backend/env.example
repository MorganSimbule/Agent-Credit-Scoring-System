# Copy this file to .env and fill in real values.
# .env should NEVER be committed to version control — add it to .gitignore.

# Paths are resolved relative to the backend directory when they are relative.
BINARY_MODEL_PATH=models/binary_default_pipeline(1).joblib
MULTICLASS_MODEL_PATH=models/multiclass_risk_pipeline(1).joblib

# Set DATABASE_URL for PostgreSQL. Leave it blank to use SQLite locally.
DATABASE_URL=

# Docker PostgreSQL settings. Replace the development password before deployment.
POSTGRES_DB=credit_scoring
POSTGRES_USER=credit_scoring
POSTGRES_PASSWORD=change-this-password

# SQLite fallback path. For Docker without PostgreSQL, use /app/data/predictions.db.
PREDICTIONS_DB_PATH=predictions.db

# Comma-separated list of allowed CORS origins (your frontend URL(s))
ALLOWED_ORIGINS=http://localhost:3000

# Required to call POST /admin/reload-models — send as the X-API-Key header.
# Generate a random value, e.g. in PowerShell:
#   -join ((48..57)+(97..122)|Get-Random -Count 32|%{[char]$_})
ADMIN_API_KEY=change-me-to-a-random-secret

# Rate limits, using slowapi's "count/period" syntax
PREDICT_RATE_LIMIT=60/minute
BATCH_RATE_LIMIT=10/minute
